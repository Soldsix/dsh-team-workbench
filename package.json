{
  "name": "dsh-team-workbench-source",
  "private": true,
  "type": "module",
  "version": "0.5.0-rc.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:ui": "node node_modules/vitest/vitest.mjs run --config vitest.ui.config.ts",
    "test:compat": "node node_modules/vitest/vitest.mjs run --config vitest.compat.config.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "check:published-types": "node scripts/check-published-types.mjs",
    "pack": "node scripts/pack.mjs",
    "check": "node scripts/check-release.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "prepare:docs": "node scripts/prepare-docs.mjs"
