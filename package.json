  "license": "MIT",
  "description": "给 DSH 配一支能长期协作的 AI 小队：双军师、孙代理、按需技能、独立验收和三栏工作台。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "modules",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "docs",
    "examples",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SHA256SUMS",
    "scripts/install.mjs",
    "public-runtime-sha256.json",
    "scripts/check-public.mjs"
  ],
