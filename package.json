    "@types/node": "22.20.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "js-yaml": "4.3.2",
    "zod": "4.4.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "ipaddr.js": "2.5.0",
    "undici": "8.11.2"
  }
